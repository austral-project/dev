{
    "name": "austral/{{BUNDLE}}",
    "type": "symfony-bundle",
    "description": "{{DESCRIPTION}}",
    "keywords": ["austral", "symfony", "bundle", "cms", "admin"],
    "homepage": "https://austral.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        },
        {
            "name": "Austral contributors",
            "homepage": "https://github.com/austral-project/{{BUNDLE}}/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/austral-project/{{BUNDLE}}/issues",
        "source": "https://github.com/austral-project/{{BUNDLE}}",
        "docs": "https://austral.dev",
        "security": "https://github.com/austral-project/.github/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Austral\\{{NAMESPACE}}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Austral\\{{NAMESPACE}}\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
