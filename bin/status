#!/usr/bin/env bash
# Repository dashboard: branch, local changes, latest tag, CI.
#   bin/status [repositories]
source "$(dirname "$0")/lib.sh"
require_cmd git
validate_selection "$@"

has_gh=0; command -v gh >/dev/null 2>&1 && has_gh=1

printf '%-28s %-8s %-8s %-10s %-12s %s\n' "REPOSITORY" "BRANCH" "CLEAN" "SYNC" "LATEST TAG" "CI 4.x"
for repo in $(select_repos "$@"); do
  dir="$(repo_dir "$repo")"
  if [ ! -d "$dir/.git" ]; then printf '%-26s %s\n' "$repo" "(not cloned)"; continue; fi
  branch="$(git -C "$dir" branch --show-current)"
  clean="yes"; [ -n "$(git -C "$dir" status --porcelain)" ] && clean="NO"
  sync="-"
  if git -C "$dir" rev-parse --verify --quiet "@{u}" >/dev/null; then
    read -r ahead behind < <(git -C "$dir" rev-list --left-right --count "HEAD...@{u}")
    sync="+$ahead/-$behind"
  fi
  tag="$(git -C "$dir" tag --list 'v*' --sort=-v:refname | head -n1)"
  ci="-"
  if [ "$has_gh" -eq 1 ]; then
    ci="$(gh run list -R "$ORG/$repo" --branch 4.x --workflow ci.yml --limit 1 \
          --json conclusion,status -q '.[0] | (.conclusion // .status)' 2>/dev/null || true)"
    [ -n "$ci" ] || ci="none"
  fi
  printf '%-26s %-8s %-8s %-10s %-12s %s\n' "$repo" "$branch" "$clean" "$sync" "${tag:--}" "$ci"
done
